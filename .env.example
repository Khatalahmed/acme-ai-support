# Runtime bots (FastAPI app, rag_bot, tool_bot, evals/generate_outputs):
#   azure  = the Azure deployment below (what this project runs on today)
#   ollama = local Ollama model (the code default if unset; needs the fine-tuned GGUF loaded
#            as "acme-support")
LLM_BACKEND=azure
# Optional: serve a different Ollama model, e.g. the un-fine-tuned base qwen3:4b
# OLLAMA_MODEL=acme-support

# Optional: where pending actions + the audit log are stored (default data/acme.db).
# The LangGraph agent's checkpoints (paused conversations) go next to it: data/acme-agent.db
# ACME_DB_PATH=data/acme.db

# Reasoning effort for RAG answers (reasoning models such as gpt-5-mini only - leave unset for
# models without reasoning, e.g. gpt-4.1). Measured in C4 (src/evals/rag_eval.py): with 5
# sections, "low" = 100% fact recall at ~4 s vs ~8 s for the model default.
# RAG_REASONING_EFFORT=low
# Same idea for status replies and "nothing to choose" explanations. Measured in C5
# (src/evals/tool_eval.py): "low" passed 60/60 conversations; status reply ~4.4 s vs ~10.5 s.
# REPLY_REASONING_EFFORT=low

# Router (API only): jev = TypeSafe Jev typed choice, falls back to the LLM router when unsure;
# llm = LLM writes a JSON decision (the code default if unset)
ROUTER_BACKEND=jev
# Shadow mode: the OTHER router also runs on real requests (in the background) and its
# decision is only recorded - see src/shadow.py and src/evals/shadow_report.py
# ROUTER_SHADOW=llm           # llm | jev | off (default off)
# ROUTER_SHADOW_RATE=1        # fraction of eligible requests to shadow (cost control)

# Jev key - set ONE (TypeSafe is used if both are set; also used by src/evals/router_compare.py):
#   TypeSafe direct:   https://console.typesafe.ai/keys  ($5 minimum top-up)
#   Vercel AI Gateway: vercel.com dashboard -> AI Gateway -> API Keys
TYPESAFE_API_KEY=
# AI_GATEWAY_API_KEY=
# Optional: override the model (default jev-latest direct, typesafe-ai/jev via Vercel)
# and set the confidence below which Jev hands the decision to the LLM router
# JEV_MODEL=jev-latest
# JEV_MIN_CONFIDENCE=0.6

# Azure OpenAI - always used by prompting_bot.py, data_pipeline/*, rag/generate_policies.py,
# evals/judge.py; used by the runtime bots when LLM_BACKEND=azure.

# Azure portal -> your Azure OpenAI resource -> Keys and Endpoint
# Uses the Azure OpenAI v1 API (<endpoint>/openai/v1/), so no api-version is needed.
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>

# The DEPLOYMENT name you chose in Azure AI Foundry (not necessarily the model name);
# this project uses a gpt-5-mini deployment
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# Optional - only generate_responses.py uses it
AZURE_OPENAI_DEPLOYMENT_FALLBACK=

# Langfuse - traces, cost, latency, the shadow-mode disagreement dataset
# (src/shadow.py, src/evals/trace_report.py, src/evals/import_disagreements.py).
# Langfuse -> your project -> Settings -> API Keys. Leave blank to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Region: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Blank keys still try to export - set this to false to switch tracing off completely
# (the tests do this)
# LANGFUSE_TRACING_ENABLED=false
